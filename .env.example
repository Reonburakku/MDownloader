# Copia este archivo como ".env" y ajusta lo que necesites. Todo es opcional.

# Carpeta donde se guardan las descargas (por defecto: Descargas\MDownloader)
# DOWNLOAD_DIR=D:\Musica

# Puerto del servidor local
# PORT=5317

# Descargas simultáneas
# CONCURRENCY=3

# Credenciales de Spotify (solo necesarias para playlists de más de 100 canciones).
# Créalas gratis en https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
