{
  "name": "mdownloader",
  "productName": "MDownloader",
  "version": "1.0.1",
  "description": "Descarga canciones desde YouTube a partir de playlists de Spotify, nombre/artista o links de YouTube",
  "author": "Manuel Méndez",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs",
    "update-ytdlp": "node scripts/setup.mjs --update",
    "start": "node server.mjs",
    "app": "electron .",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "com.mdownloader.app",
    "productName": "MDownloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "lib/**",
      "public/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "MDownloader-Setup-${version}.${ext}"
    }
  }
}
